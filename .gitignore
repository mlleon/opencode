# .gitignore

# 先忽略所有文件和目录
*

# =========================
# 保留需要进入仓库的内容
# =========================

!/.gitignore
!/opencode.json

!/bakeup/
!/bakeup/**

!/dotfiles/
!/dotfiles/**

!/tmux-手册.md
!/手机Termux连WSL部署手册.md

!/skills/
!/skills/**

# =========================
# Python 虚拟环境
# =========================

/skills/.venv/
/skills/*/.venv/
**/.venv/

# =========================
# Python 缓存文件
# =========================

**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# =========================
# 常见编辑器缓存
# =========================

**/.DS_Store
**/Thumbs.db
**/.vscode/
**/.idea/

# =========================
# Python 构建产物
# =========================

**/build/
**/dist/
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.uv/
**/.coverage
**/htmlcov/
