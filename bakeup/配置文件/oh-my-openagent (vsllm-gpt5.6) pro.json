  "claude_code": {
    "skills": false,
    "commands": false,
    "plugins": false,
    "agents": false,
    "hooks": false,
    "mcp": false
  },
  "auto_update": true,
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      402,
      429,
      500,
      502,
      503,
      504
    ],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 120,
    "timeout_seconds": 60,
    "notify_on_fallback": true
  },
  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": true,
    "git_env_prefix": "GIT_MASTER=1"
  },
  "experimental": {
    "preemptive_compaction": true
  }
}
